# Copy this file to .env and fill in the values. Never commit .env.
# Hardhat (hardhat.config.js) and Next.js both read .env.

## Frontend (read by Next.js at build time; NEXT_PUBLIC_ values end up in
## the public JavaScript, so never put a secret in one)

# Address of the deployed ChatApp contract. The public Hoodi deployment is
# below; replace it with the address `npm run deploy` prints for your own.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x8e4BBf86322Ab47D7cd2c6E313eEa72da328510C
# Network MetaMask is switched to. One of the keys in Context/networks.js:
# hoodi, sepolia, localhost.
NEXT_PUBLIC_NETWORK=hoodi

## Contract deployment (only needed for `npm run deploy`)

# RPC URL of a Hoodi node. Optional: defaults to the free public node
# https://ethereum-hoodi-rpc.publicnode.com. An Alchemy or Infura URL is
# more reliable.
HOODI_RPC_URL=
# Private key of the wallet that pays gas for the deployment. Use a fresh
# wallet that only ever holds testnet ETH (from a Hoodi faucet). Never share
# or commit it.
DEPLOYER_PRIVATE_KEY=
# Public address of the relayer wallet that posts the epoch roots to
# ChatAnchor. Only the address, never its key here. Required for `npm run deploy`.
RELAYER_ADDRESS=

## Backend (Vercel Functions + Neon; read at run time on the server, never NEXT_PUBLIC_)

# Neon Postgres connection string. Create a free database (Vercel Storage, Neon),
# then run `npm run db:migrate` once to create the tables.
DATABASE_URL=
# At least 32 random characters that encrypt the session cookie, for example
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
SESSION_SECRET=
# Hosts a sign-in message may name, comma separated (the site's own host, no scheme).
# Required in production. Locally it defaults to localhost:3000.
SIWE_ALLOWED_DOMAINS=
# Optional overrides: chain id the sign-in message must use (default: Hoodi, 560048),
# messages one address may send per minute (default 30).
SIWE_CHAIN_ID=
MESSAGES_PER_MINUTE=
